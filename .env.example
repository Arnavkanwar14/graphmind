# Neon Postgres connection string (postgres://...)
DATABASE_URL=
# Groq API key for LLM calls
GROQ_API_KEY=
# Master key for envelope encryption — generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# BACK THIS UP IN A PASSWORD MANAGER. Loss = all customer data unreadable.
ENCRYPTION_KEY=
# Google Cloud OAuth client (Web application) for the Drive connector.
# Redirect URI must be exactly <app-url>/api/connectors/gdrive/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional Gemini key — extraction falls over to Gemini when Groq is rate-limited
GEMINI_API_KEY=
